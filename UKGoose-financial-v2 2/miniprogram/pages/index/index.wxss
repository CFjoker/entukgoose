.wrap{padding:32rpx}.header{display:flex;align-items:center;justify-content:space-between}.brand{font-size:48rpx;font-weight:900;font-style:italic;letter-spacing:-3rpx}.tag{font-size:18rpx;color:#778469;letter-spacing:2rpx}.hero{position:relative;background:#eeedcf;border-radius:50rpx;margin:32rpx 0 20rpx;padding:36rpx 30rpx 20rpx;overflow:hidden}.eyebrow{font-size:16rpx;letter-spacing:2rpx;display:block}.headline{white-space:pre-line;font-size:66rpx;font-weight:800;letter-spacing:-3rpx;line-height:1.05;display:block;margin-top:25rpx}.italic{font-family:Georgia,serif;font-size:54rpx;font-style:italic;display:block}.goose{width:100%;height:340rpx;animation:float 5s ease-in-out infinite}.sub{display:block;font-size:19rpx;text-align:center}.notice{font-size:19rpx;color:#7b816b;margin-bottom:28rpx;text-align:center}.card{background:#fffdf5;border:1rpx solid #dbe0d1;border-radius:32rpx;padding:30rpx;margin-bottom:28rpx}.section{display:block;font-family:Georgia,serif;font-size:34rpx;margin-bottom:28rpx}.label{font-size:22rpx;color:#6c7862}.row{display:flex;gap:20rpx}.row>view{flex:1;min-width:0}.switch{display:flex;align-items:center;justify-content:space-between;font-size:24rpx;gap:12rpx}.estimate{background:#eeefdf}.price{font-size:76rpx;display:block}.line{display:flex;justify-content:space-between;padding:18rpx 0;border-bottom:1rpx solid #dadfce;font-size:26rpx}.note{display:block;background:#fff2b9;padding:18rpx;border-radius:15rpx;margin:20rpx 0;font-size:24rpx}.fine{display:block;font-size:21rpx;color:#77816c;line-height:1.7}.order-title{display:block;font-size:34rpx;font-weight:700;margin:15rpx 0}.event{border-left:4rpx solid #e5bf27;padding-left:20rpx;margin:25rpx 0;font-size:25rpx}.footer{display:block;text-align:center;font-size:18rpx;letter-spacing:3rpx;padding:30rpx}@keyframes float{50%{transform:translateY(-10rpx)}}